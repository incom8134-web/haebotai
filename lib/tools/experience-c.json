  "brand-dna": {
    "layout": "steps",
    "visual": "compass",
    "hero": {
      "title": {
        "ko": "브랜드의 기준을 한 장에",
        "en": "Your brand's rules, on one page"
      },
      "story": {
        "ko": "무엇을 누구에게 파는지와 원하는 성격만 알려 주세요. 색, 서체, 말투, 약속까지 모든 결과물이 따를 기준을 만들어 드려요.",
        "en": "Tell us what you sell, to whom, and the personality you want. We'll set the colours, type, voice and promise everything else follows."
      }
    },
    "sections": [
      {
        "title": {
          "ko": "무엇을 누구에게",
          "en": "What and for whom"
