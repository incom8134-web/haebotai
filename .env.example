NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY — bypasses Row Level Security entirely (lib/supabase/admin.ts).
# Never prefix with NEXT_PUBLIC_, never import lib/supabase/admin.ts from a
# Client Component, never log it or put it in an error message. Treat a leak
# of this key as a full database compromise, not just an API key leak.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_GENAI_API_KEY=             # from ai.google.dev
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional — login buttons beyond Google, e.g. "google,kakao" (Kakao must also
# be enabled in Supabase). Inlined at build time: redeploy after changing it.
NEXT_PUBLIC_AUTH_PROVIDERS=
# Optional — site-ownership meta tags: the content="…" value that Google Search
# Console / Naver Search Advisor shows for the HTML-tag method.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
# Optional — enables "bring your own API key". MUST be a random value, not a
# password or anything memorable: generate with `openssl rand -base64 32`.
# Every stored key is only as safe as this secret; losing it means every
# user's stored key must be re-entered (see lib/crypto/secret-box.ts).
API_KEY_ENCRYPTION_SECRET=
# Optional — enables the Pro checkout (/account/membership/checkout) via
# Toss Payments 결제위젯. Both must be set; test keys (test_gck_/test_gsk_)
# never charge real money. The secret key is SERVER-ONLY.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# Spend protection (lib/spend-guard-core.ts). All optional — defaults shown.
# Daily ceiling on platform-key AI runs, in credits (≈ what they'd cost a
# member); new platform runs pause for the day once it's reached.
PLATFORM_DAILY_CREDIT_CAP=150000
# Most tool runs one member can start per day (own-key runs included).
USER_DAILY_RUN_CAP=60
# Emergency stop for platform-key runs: set to 1 (or set the Redis key
# spend:killswitch to 1 in the Upstash console for an instant stop).
PLATFORM_AI_DISABLED=
# Slack/Discord/any JSON webhook for budget alerts at 50/80/100 % and for
# members hitting the daily run cap. Without it alerts go to the server log.
BUDGET_ALERT_WEBHOOK_URL=
# Recommended with Toss — protects /api/cron/reconcile-payments, the daily
# job (vercel.json) that fixes orders the success page missed. Vercel sends
# it as a Bearer token automatically. Generate with `openssl rand -base64 32`.
CRON_SECRET=
